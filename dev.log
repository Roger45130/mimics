[2025-04-03T09:37:15.170751+00:00] doctrine.DEBUG: Executing statement: UPDATE blog SET title = ?, excerpt = ?, content = ? WHERE id = ? (parameters: array{"1":"Aktibat fête ses 25 ans : un quart de siècle de passion pour la maçonnerie générale !","2":"En octobre 2025, Aktibat, entreprise de maçonnerie générale fondée par Jean-Louis LE GRASSE à Saint-Laurent-des-Bois, célèbre ses 25 ans. Créée après une formation auprès des Compagnons du Tour de France, Aktibat se distingue par la passion et le savoir-faire exceptionnel de son dirigeant. Depuis sa création, l'entreprise met un point d'honneur à réaliser avec précision et rigueur chaque projet confié par ses clients, consolidant ainsi sa réputation d'excellence dans le métier de la maçonnerie.","3":"En octobre 2025, Aktibat célébrera fièrement ses 25 années d’existence. Fondée en octobre 2005 par Monsieur Jean-Louis LE GRASSE, cette entreprise de maçonnerie générale située à Saint-Laurent-des-Bois dans le Loir-et-Cher est devenue au fil du temps une référence incontournable dans son domaine. Animé par une passion indéfectible pour son métier, Jean-Louis LE GRASSE a bâti Aktibat sur des bases solides, mêlant savoir-faire traditionnel et modernité technique.\r\n\r\nLa création d'Aktibat fait suite à plusieurs années d'expérience professionnelle enrichissante de son fondateur ainsi qu'à une formation approfondie au sein de la prestigieuse Fédération Compagnonique des Métiers du Bâtiment (F.C.M.B.). Entouré de formateurs reconnus, tous Compagnons du Tour de France, Monsieur LE GRASSE a acquis un savoir-faire authentique et exigeant, garantissant des travaux de haute qualité à tous ses clients.\r\n\r\nLa passion est le moteur d'Aktibat. Depuis ses débuts, Jean-Louis LE GRASSE met un point d’honneur à concrétiser chaque projet de ses clients avec rigueur et précision. Que ce soit pour des constructions neuves, des rénovations ou des extensions, chaque réalisation porte l’empreinte d’un engagement sincère et d’un amour profond pour le métier de maçon. Cette philosophie permet à Aktibat de répondre parfaitement aux attentes et exigences variées de sa clientèle.\r\n\r\nCélébrer les 25 ans d’Aktibat, c’est aussi célébrer un quart de siècle d'excellence dans la maçonnerie générale. Cet anniversaire sera l'occasion de mettre en lumière le parcours remarquable de cette entreprise familiale ainsi que ses nombreuses réalisations marquantes. Aktibat regarde déjà vers l’avenir, prête à continuer à accompagner ses clients dans la réalisation de leurs projets les plus ambitieux, avec toujours autant de passion et de professionnalisme.","4":2}, types: array{"1":2,"2":2,"3":2,"4":1}) {"sql":"UPDATE blog SET title = ?, excerpt = ?, content = ? WHERE id = ?","params":{"1":"Aktibat fête ses 25 ans : un quart de siècle de passion pour la maçonnerie générale !","2":"En octobre 2025, Aktibat, entreprise de maçonnerie générale fondée par Jean-Louis LE GRASSE à Saint-Laurent-des-Bois, célèbre ses 25 ans. Créée après une formation auprès des Compagnons du Tour de France, Aktibat se distingue par la passion et le savoir-faire exceptionnel de son dirigeant. Depuis sa création, l'entreprise met un point d'honneur à réaliser avec précision et rigueur chaque projet confié par ses clients, consolidant ainsi sa réputation d'excellence dans le métier de la maçonnerie.","3":"En octobre 2025, Aktibat célébrera fièrement ses 25 années d’existence. Fondée en octobre 2005 par Monsieur Jean-Louis LE GRASSE, cette entreprise de maçonnerie générale située à Saint-Laurent-des-Bois dans le Loir-et-Cher est devenue au fil du temps une référence incontournable dans son domaine. Animé par une passion indéfectible pour son métier, Jean-Louis LE GRASSE a bâti Aktibat sur des bases solides, mêlant savoir-faire traditionnel et modernité technique.\r\n\r\nLa création d'Aktibat fait suite à plusieurs années d'expérience professionnelle enrichissante de son fondateur ainsi qu'à une formation approfondie au sein de la prestigieuse Fédération Compagnonique des Métiers du Bâtiment (F.C.M.B.). Entouré de formateurs reconnus, tous Compagnons du Tour de France, Monsieur LE GRASSE a acquis un savoir-faire authentique et exigeant, garantissant des travaux de haute qualité à tous ses clients.\r\n\r\nLa passion est le moteur d'Aktibat. Depuis ses débuts, Jean-Louis LE GRASSE met un point d’honneur à concrétiser chaque projet de ses clients avec rigueur et précision. Que ce soit pour des constructions neuves, des rénovations ou des extensions, chaque réalisation porte l’empreinte d’un engagement sincère et d’un amour profond pour le métier de maçon. Cette philosophie permet à Aktibat de répondre parfaitement aux attentes et exigences variées de sa clientèle.\r\n\r\nCélébrer les 25 ans d’Aktibat, c’est aussi célébrer un quart de siècle d'excellence dans la maçonnerie générale. Cet anniversaire sera l'occasion de mettre en lumière le parcours remarquable de cette entreprise familiale ainsi que ses nombreuses réalisations marquantes. Aktibat regarde déjà vers l’avenir, prête à continuer à accompagner ses clients dans la réalisation de leurs projets les plus ambitieux, avec toujours autant de passion et de professionnalisme.","4":2},"types":{"1":2,"2":2,"3":2,"4":1}} []
