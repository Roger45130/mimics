[2025-04-03T11:27:08.039906+00:00] doctrine.DEBUG: Executing statement: UPDATE blog SET content = ? WHERE id = ? (parameters: array{"1":"En octobre 2025, Aktibat célébrera fièrement ses 25 années d’existence. Fondée en octobre 2005 par Monsieur Jean-Louis LE GRASSE, cette entreprise de maçonnerie générale située à Saint-Laurent-des-Bois dans le Loir-et-Cher est devenue au fil du temps une référence incontournable dans son domaine. Animé par une passion indéfectible pour son métier, Jean-Louis LE GRASSE a bâti Aktibat sur des bases solides, mêlant savoir-faire traditionnel et modernité technique.\r\n\r\nLa création d'Aktibat fait suite à plusieurs années d'expérience professionnelle enrichissante de son fondateur ainsi qu'à une formation approfondie au sein de la prestigieuse Fédération Compagnonique des Métiers du Bâtiment (F.C.M.B.). Entouré de formateurs reconnus, tous Compagnons du Tour de France, Jean-Louis LE GRASSE a acquis un savoir-faire authentique et exigeant, garantissant des travaux de haute qualité à tous ses clients.\r\n\r\nLa passion est le moteur d'Aktibat. Depuis ses débuts, Jean-Louis LE GRASSE met un point d’honneur à concrétiser chaque projet de ses clients avec rigueur et précision. Qu'il s'agisse de constructions neuves, de rénovations ou d'extensions, chaque projet témoigne de l'engagement sincère et de l'attachement profond au métier de maçon. Cette philosophie permet à Aktibat de répondre parfaitement aux attentes et exigences variées de sa clientèle.\r\n\r\nCélébrer les 25 ans d’Aktibat, c’est aussi célébrer un quart de siècle d'excellence dans la maçonnerie générale. Cet anniversaire sera l'occasion de mettre en lumière le parcours remarquable de cette entreprise familiale ainsi que ses nombreuses réalisations marquantes. Aktibat regarde déjà vers l’avenir, prête à continuer à accompagner ses clients dans la réalisation de leurs projets les plus ambitieux, avec toujours autant de passion et de professionnalisme.","2":2}, types: array{"1":2,"2":1}) {"sql":"UPDATE blog SET content = ? WHERE id = ?","params":{"1":"En octobre 2025, Aktibat célébrera fièrement ses 25 années d’existence. Fondée en octobre 2005 par Monsieur Jean-Louis LE GRASSE, cette entreprise de maçonnerie générale située à Saint-Laurent-des-Bois dans le Loir-et-Cher est devenue au fil du temps une référence incontournable dans son domaine. Animé par une passion indéfectible pour son métier, Jean-Louis LE GRASSE a bâti Aktibat sur des bases solides, mêlant savoir-faire traditionnel et modernité technique.\r\n\r\nLa création d'Aktibat fait suite à plusieurs années d'expérience professionnelle enrichissante de son fondateur ainsi qu'à une formation approfondie au sein de la prestigieuse Fédération Compagnonique des Métiers du Bâtiment (F.C.M.B.). Entouré de formateurs reconnus, tous Compagnons du Tour de France, Jean-Louis LE GRASSE a acquis un savoir-faire authentique et exigeant, garantissant des travaux de haute qualité à tous ses clients.\r\n\r\nLa passion est le moteur d'Aktibat. Depuis ses débuts, Jean-Louis LE GRASSE met un point d’honneur à concrétiser chaque projet de ses clients avec rigueur et précision. Qu'il s'agisse de constructions neuves, de rénovations ou d'extensions, chaque projet témoigne de l'engagement sincère et de l'attachement profond au métier de maçon. Cette philosophie permet à Aktibat de répondre parfaitement aux attentes et exigences variées de sa clientèle.\r\n\r\nCélébrer les 25 ans d’Aktibat, c’est aussi célébrer un quart de siècle d'excellence dans la maçonnerie générale. Cet anniversaire sera l'occasion de mettre en lumière le parcours remarquable de cette entreprise familiale ainsi que ses nombreuses réalisations marquantes. Aktibat regarde déjà vers l’avenir, prête à continuer à accompagner ses clients dans la réalisation de leurs projets les plus ambitieux, avec toujours autant de passion et de professionnalisme.","2":2},"types":{"1":2,"2":1}} []
