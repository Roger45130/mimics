{% extends 'base.html.twig' %}

{% block title %}Register
{% endblock %}

{% block body %}
	<div class="container mb-4">
		<h1 class="text-center my-4">Créer votre compte</h1>

		{{ form_start(registrationForm) }}
		{# <input type="text"  #}

		{{ form_row(registrationForm.firstName) }}
		{{ form_row(registrationForm.lastName) }}
		{{ form_row(registrationForm.email) }}
		{{ form_row(registrationForm.phone) }}
		{{ form_row(registrationForm.address) }}
		{{ form_row(registrationForm.city) }}
		{{ form_row(registrationForm.zipcode) }}
		{{ form_row(registrationForm.password) }}
		{{ form_row(registrationForm.agreeTerms) }}
		<button type="submit" class="btn btn-dark">Continuer</button>

		{{ form_end(registrationForm) }}
		{# </form> #}
	</div>
{% endblock %}
