{% extends 'base.html.twig' %}

{% block title %}
	Minics | Détails de l'article
{% endblock %}

{% block body %}

	<h1 class="text-center my-4">{{ product.title }}</h1>

	<div class="container my-5 d-flex">
		<div class="img-box mr-4">
			<img src="{{ asset('uploads/images/' ~ product.picture) }}" alt="{{ product.title }}">
		</div>
		<div class="detail-box">
			<h5>Référence :
				{{ product.reference }}</h5>
			<h5>Catégorie :
				{{ product.category.title }}</h5>
			<h5>Couleur :
				{{ product.color }}</h5>
			<h5>Genre :
				{{ product.gender }}</h5>
			<h5>Mémoire :
				{{ product.size }}</h5>
			<h5>description :
				{{ product.description }}</h5>

			<h5>
				<strong>
					{{ product.price }}€</strong>
			</h5>

			{% if product.stock %}
				{% if product.stock <= 5 %}
					<i class="text-danger">Plus que
						{{ product.stock }}
						articles disponible</i>
				{% endif %}

				<form action="{{ path('app_cart_add', {'id': product.id}) }}" method="post" class="d-flex align-items-center mt-4">
					<div class="form-group m-0">
						<select
							name="quantity" id="quantity" class="form-control">

							{#for($i = 1; $i > $product['stock']; $i++)#}
							{% for item in 1..product.stock %}
								{% if item <= product.stock and item <= 10 %}
									<option value="{{ item }}">{{ item }}</option>
								{% endif %}
							{% endfor %}
						</select>
					</div>
					<button type="submit" class="ml-2 btn btn-dark">AJOUTER AUX PANIER</button>
				</form>

			{% else %}
				<i class="text-danger">Rupture de stock!</i>
			{% endif %}

		</div>
	</div>

{% endblock %}
